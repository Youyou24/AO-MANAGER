# ==== AO Manager — exemple de configuration ====
# Copiez ce fichier en `.env` et remplissez les valeurs.
# Ne JAMAIS committer votre vrai `.env` (il contient des secrets).

# --- Base de données PostgreSQL ---
# Renseignez ici l'URL fournie par votre hébergeur de base (ex: Neon, Supabase, Railway).
# Format: postgresql://UTILISATEUR:MOT_DE_PASSE@HOTE:PORT/BASE?sslmode=require
DATABASE_URL="postgresql://user:password@host:5432/appels_offres?sslmode=require"

# --- Mot de passe de connexion à l'application ---
# Les utilisateurs de l'application saisiront ce mot de passe pour se connecter.
AUTH_PASSWORD="AO-2026!changez"

# --- Clé secrète (sessions) ---
# Générer avec: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
AUTH_SECRET="generer-une-valeur-aleatoire"

# --- Stockage des fichiers importés (optionnel) ---
# Dossier local où écrire les uploads. Sur un hébergement sans disque persistant
# (ex: Vercel), les fichiers sont temporaires. Préférez un stockage objet persistant.
# UPLOAD_DIR="./uploads"
